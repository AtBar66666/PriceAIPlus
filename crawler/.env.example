# 复制为 .env 后按需修改。前缀统一为 PRICEAI_

# 服务监听
PRICEAI_HOST=127.0.0.1
PRICEAI_PORT=8756

# 抓取目标与指纹
PRICEAI_BASE_URL=https://www.ldxp.cn
PRICEAI_CATFK_BASE_URL=https://catfk.com
PRICEAI_PICKAI_BASE_URL=https://pickai.cc
PRICEAI_IMPERSONATE=chrome

# 节奏控制（毫秒）
PRICEAI_MIN_DELAY_MS=3000
PRICEAI_MAX_DELAY_MS=6000
PRICEAI_MAX_CONCURRENCY=3
PRICEAI_PICKAI_WORKERS=3
PRICEAI_PICKAI_REFRESH_MINUTES=30

# Merchant-Token（ldxp localStorage auth-token 的 value；也可在「设置」页粘贴）
PRICEAI_MERCHANT_TOKEN=

# 登录态 Cookie（可选，一般不需要）
PRICEAI_COOKIE=
